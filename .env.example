# Optional deployment overrides.
#
# Copy this file to `.env` for local builds, or set the same values as
# repository variables in GitHub (Settings → Secrets and variables → Actions →
# Variables) so the deploy workflow picks them up.
#
# User site — https://<username>.github.io/
SITE_URL=https://bcila.github.io
BASE_PATH=/
#
# Project site — https://<username>.github.io/<repository>/
# SITE_URL=https://bcila.github.io
# BASE_PATH=/bcila.github.io

# Optional: external form provider endpoint.
# Leave empty to keep the static mailto/GitHub/LinkedIn contact options only.
# PUBLIC_CONTACT_FORM_ENDPOINT=
