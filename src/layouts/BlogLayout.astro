---
import type { MarkdownHeading } from 'astro';
import { ArrowLeft, Clock, CalendarDays, MapPin, Sparkles } from '@lucide/astro';
import MainLayout from './MainLayout.astro';
import BlogCard from '@/components/BlogCard.astro';
import ShareLinks from '@/components/ShareLinks.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import type { BlogPost } from '@/utils/blog';
import { readingTime } from '@/utils/blog';
import { formatLongDate } from '@/utils/date';
import { profile } from '@/data/profile';
import { withBase } from '@/utils/url';

interface Props {
  post: BlogPost;
  headings: MarkdownHeading[];
  relatedPosts: BlogPost[];
}

const { post, headings, relatedPosts } = Astro.props;

const minutes = readingTime(post.body);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const articleUrl = new URL(withBase(`/blog/${post.id}/`), Astro.site ?? profile.site.url).href;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: new URL(withBase(post.data.cover), Astro.site ?? profile.site.url).href,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: post.data.author },
  publisher: { '@type': 'Person', name: profile.name },
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  keywords: post.data.tags.join(', '),
  articleSection: post.data.category,
};
---

<MainLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover}
  imageAlt={post.data.coverAlt}
  type="article"
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate}
  structuredData={articleSchema}
>
  <article>
    <header class="article-header">
      <div class="container-page">
        <div class="max-w-3xl">
          <a href={withBase('/blog/')} class="inline-flex items-center gap-1.5 text-xs text-muted hover:text-fg">
            <ArrowLeft size={13} aria-hidden="true" />
            All articles
          </a>

          <div class="mt-6 flex flex-wrap items-center gap-2">
            <span class="badge badge-accent">{post.data.category}</span>
            {post.data.sample && <span class="badge">Sample article</span>}
          </div>

          <h1 class="page-title mt-5">{post.data.title}</h1>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
            {post.data.description}
          </p>

          <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[0.68rem] text-faint">
            <span class="inline-flex items-center gap-1.5 text-muted">
              <span class="grid size-5 place-items-center rounded border border-line bg-panel text-[0.55rem] text-fg">
                {profile.initials}
              </span>
              {post.data.author}
            </span>
            <span class="inline-flex items-center gap-1.5">
              <CalendarDays size={12} aria-hidden="true" />
              <time datetime={post.data.pubDate.toISOString()}>
                {formatLongDate(post.data.pubDate)}
              </time>
            </span>
            <span class="inline-flex items-center gap-1.5">
              <Clock size={12} aria-hidden="true" />
              {minutes} min read
            </span>
            {post.data.updatedDate && (
              <span>Updated {formatLongDate(post.data.updatedDate)}</span>
            )}
          </div>

          {
            post.data.sample && (
              <div class="callout mt-7">
                <Sparkles size={17} class="mt-0.5 shrink-0 text-accent" stroke-width={1.7} aria-hidden="true" />
                <div>
                  <p class="callout-title">Sample content</p>
                  <p class="callout-body">
                    This article is starter content for the portfolio template. Its code and
                    explanations are illustrative — replace it with your own writing before
                    publishing.
                  </p>
                </div>
              </div>
            )
          }
        </div>

        <figure class="mx-auto mt-10 max-w-5xl overflow-hidden rounded-2xl border border-line">
          <img
            src={withBase(post.data.cover)}
            alt={post.data.coverAlt}
            width="1200"
            height="630"
            class="w-full"
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </header>

    <div class="container-page pb-20">
      <div class="article-layout">
        <div class="article-body">
          <div class="prose">
            <slot />
          </div>

          <div class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6">
            <ul class="flex flex-wrap gap-1.5" aria-label="Tags">
              {post.data.tags.map((tag) => <li class="tag">#{tag}</li>)}
            </ul>
            <ShareLinks title={post.data.title} url={articleUrl} />
          </div>

          <div class="card mt-10 flex flex-col gap-4 p-5 sm:flex-row sm:items-start">
            <span class="grid size-11 shrink-0 place-items-center rounded-lg border border-line-strong bg-bg-soft font-mono text-xs font-semibold">
              {profile.initials}
            </span>
            <div class="min-w-0 flex-1">
              <p class="text-sm font-semibold">{profile.name}</p>
              <p class="mt-1 font-mono text-[0.64rem] uppercase tracking-wider text-faint">
                {profile.title} · {profile.location}
              </p>
              <p class="mt-2 text-sm leading-relaxed text-muted">{profile.bio}</p>
              <div class="mt-3 flex flex-wrap items-center gap-2">
                <SocialLinks />
                <a href={`mailto:${profile.email}`} class="text-xs text-muted hover:text-fg">
                  {profile.email}
                </a>
              </div>
            </div>
          </div>

          {
            relatedPosts.length > 0 && (
              <section class="mt-14" aria-labelledby="related-title">
                <div class="flex items-end justify-between gap-4">
                  <div>
                    <p class="mono-label">Keep reading</p>
                    <h2 class="section-title mt-3" id="related-title">
                      Related articles
                    </h2>
                  </div>
                  <a href={withBase('/blog/')} class="link-arrow hidden sm:inline-flex">
                    All articles
                  </a>
                </div>
                <div class="mt-6 grid gap-4 sm:grid-cols-2">
                  {relatedPosts.map((related) => <BlogCard post={related} />)}
                </div>
              </section>
            )
          }
        </div>

        <aside class="article-aside" aria-label="Article sidebar">
          {
            toc.length > 1 && (
              <nav class="toc" aria-label="Table of contents">
                <p class="toc-title">On this page</p>
                <ul class="toc-list">
                  {toc.map((heading) => (
                    <li class={`depth-${heading.depth}`}>
                      <a href={`#${heading.slug}`}>{heading.text}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }

          <div class="mt-4 rounded-xl border border-line bg-panel p-4">
            <div class="mt-1">
              <ShareLinks title={post.data.title} url={articleUrl} />
            </div>
            <div class="mt-4 border-t border-line pt-4">
              <p class="flex items-center gap-1.5 text-xs text-muted">
                <MapPin size={11} aria-hidden="true" />
                Written from {profile.location}
              </p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </article>
</MainLayout>
