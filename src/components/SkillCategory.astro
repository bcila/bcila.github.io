---
import {
  Cloud,
  Code,
  Database,
  LayoutTemplate,
  Server,
  Wrench,
} from '@lucide/astro';
import type { SkillCategory, SkillCategoryIcon } from '@/data/skills';

interface Props {
  category: SkillCategory;
  /** Heading level for the card title, so listing pages keep a valid order. */
  headingLevel?: 'h2' | 'h3';
}

const { category, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;

const icons: Record<SkillCategoryIcon, typeof Code> = {
  code: Code,
  layout: LayoutTemplate,
  server: Server,
  database: Database,
  cloud: Cloud,
  wrench: Wrench,
};

const Icon: typeof Code = icons[category.icon];
---

<article class="card skill-card">
  <div class="flex items-start justify-between gap-3">
    <span class="skill-icon" aria-hidden="true">
      <Icon size={18} stroke-width={1.6} />
    </span>
    <span class="font-mono text-[0.62rem] text-faint">
      {String(category.skills.length).padStart(2, '0')}
    </span>
  </div>

  <div>
    <Heading class="skill-title">{category.title}</Heading>
    <p class="skill-description">{category.description}</p>
  </div>

  <ul class="skill-list" aria-label={`${category.title} skills`}>
    {category.skills.map((skill) => <li class="tag">{skill}</li>)}
  </ul>
</article>
