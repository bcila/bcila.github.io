---
import { ArrowUpRight, CircleCheck } from '@lucide/astro';
import MainLayout from '@/layouts/MainLayout.astro';
import SkillCategoryCard from '@/components/SkillCategory.astro';
import { skillCategories } from '@/data/skills';
import { profile } from '@/data/profile';
import { withBase } from '@/utils/url';

const totalSkills = skillCategories.reduce((total, category) => total + category.skills.length, 0);
---

<MainLayout
  title="Skills"
  description={`Technical skills of ${profile.name}: backend development, realtime systems, databases, and cloud infrastructure.`}
>
  <header class="border-b border-line">
    <div class="container-page pb-12 pt-14 sm:pb-16 sm:pt-20">
      <div class="grid grid-cols-[minmax(0,1fr)] gap-8 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-end">
        <div class="max-w-3xl">
          <p class="mono-label">Toolkit</p>
          <h1 class="page-title mt-5">Skills</h1>
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
            A practical, honest inventory — grouped by where each tool fits. No percentages or
            progress bars, because those numbers never mean much.
          </p>
        </div>

        <div class="card flex items-center justify-between gap-4 p-4 lg:justify-self-end">
          <div>
            <p class="font-mono text-[0.62rem] uppercase tracking-wider text-faint">Listed</p>
            <p class="mt-1 text-2xl font-semibold tracking-tight">{totalSkills}</p>
          </div>
          <span class="h-9 w-px bg-line" aria-hidden="true"></span>
          <div>
            <p class="font-mono text-[0.62rem] uppercase tracking-wider text-faint">Categories</p>
            <p class="mt-1 text-2xl font-semibold tracking-tight">{skillCategories.length}</p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <section class="section-sm" aria-label="Skill categories">
    <div class="container-page">
      <div class="skills-grid">
        {
          skillCategories.map((category, index) => (
            <div class="reveal" style={`--reveal-delay: ${(index % 3) * 60}ms`}>
              <SkillCategoryCard category={category} headingLevel="h2" />
            </div>
          ))
        }
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-3">
        <article class="card p-5">
          <p class="mono-label">How I work</p>
          <h2 class="mt-3 text-base font-semibold">Clear interfaces first</h2>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            A well-defined API and data model make the rest of the system easier to reason about.
          </p>
        </article>
        <article class="card p-5">
          <p class="mono-label">Reliability</p>
          <h2 class="mt-3 text-base font-semibold">Async by default</h2>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            Keep slow work off the request path. Retries, idempotency, and observability are part of
            the design.
          </p>
        </article>
        <article class="card p-5">
          <p class="mono-label">Realtime</p>
          <h2 class="mt-3 text-base font-semibold">Latency is a feature</h2>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            In voice and streaming systems, the difference between usable and great is measured in
            milliseconds.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section border-t border-line" aria-labelledby="skills-cta-title">
    <div class="container-page">
      <div class="grid grid-cols-[minmax(0,1fr)] gap-8 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="mono-label">Fit</p>
          <h2 class="section-title mt-4" id="skills-cta-title">
            Backend, realtime, or AI infrastructure — that is where I do my best work.
          </h2>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-muted">
            If your team needs someone to own services end to end, from API design through
            deployment, I would like to hear about it.
          </p>
          <div class="mt-6 flex flex-wrap gap-2">
            <a href={withBase('/#contact')} class="btn btn-primary">
              Contact me
              <ArrowUpRight size={14} aria-hidden="true" />
            </a>
            <a href={withBase('/projects/')} class="btn btn-secondary">See projects</a>
          </div>
        </div>

        <ul class="grid gap-3 sm:grid-cols-2">
          {[
            'Designing REST and WebSocket APIs',
            'Building async Python services',
            'Working with relational and vector data',
            'Deploying to AWS, Azure, and Coolify',
          ].map((item) => (
            <li class="card flex items-start gap-2.5 p-4 text-sm text-muted">
              <CircleCheck size={15} class="mt-0.5 shrink-0 text-accent" aria-hidden="true" />
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</MainLayout>
