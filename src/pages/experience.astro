---
import { Award, Download, GraduationCap, MapPin } from '@lucide/astro';
import MainLayout from '@/layouts/MainLayout.astro';
import ExperienceTimeline from '@/components/ExperienceTimeline.astro';
import { certifications, education, experience } from '@/data/experience';
import { profile } from '@/data/profile';
import { withBase } from '@/utils/url';
---

<MainLayout
  title="Experience"
  description={`Professional experience and education for ${profile.name}, backend developer.`}
>
  <header class="border-b border-line">
    <div class="container-page pb-12 pt-14 sm:pb-16 sm:pt-20">
      <div class="grid grid-cols-[minmax(0,1fr)] gap-8 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-end">
        <div class="max-w-3xl">
          <p class="mono-label">Career</p>
          <h1 class="page-title mt-5">Experience</h1>
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
            Three years of backend work across mobile products at scale, realtime voice AI, and
            internal tooling. Below is the full timeline, including education and training.
          </p>
        </div>

        <div class="flex flex-wrap gap-2 lg:justify-end">
          <a href={withBase(profile.resumeUrl)} class="btn btn-secondary" download>
            <Download size={14} aria-hidden="true" />
            Download resume
          </a>
          <a href={withBase('/#contact')} class="btn btn-primary">Get in touch</a>
        </div>
      </div>
    </div>
  </header>

  <section class="section-sm" aria-labelledby="work-title">
    <div class="container-page">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="mono-label">Professional</p>
          <h2 class="section-title mt-3" id="work-title">Work history</h2>
        </div>
        <p class="hidden font-mono text-[0.66rem] text-faint sm:block">
          {experience.length} roles · Most recent first
        </p>
      </div>

      <div class="mt-8">
        <ExperienceTimeline entries={experience} />
      </div>
    </div>
  </section>

  <section class="section-sm border-t border-line" aria-labelledby="education-title">
    <div class="container-page">
      <div class="grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[18rem_minmax(0,1fr)]">
        <div>
          <p class="mono-label">Education</p>
          <h2 class="section-title mt-3" id="education-title">Foundations</h2>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            A computer engineering degree and an early, intensive web development bootcamp.
          </p>
        </div>

        <div class="grid gap-4">
          {
            education.map((entry) => (
              <article class="card p-5 sm:p-6">
                <div class="flex flex-wrap items-start justify-between gap-4">
                  <div class="flex gap-3.5">
                    <span class="skill-icon" aria-hidden="true">
                      <GraduationCap size={18} stroke-width={1.6} />
                    </span>
                    <div>
                      <h3 class="text-base font-semibold">{entry.institution}</h3>
                      <p class="mt-0.5 text-sm text-accent">{entry.degree} {entry.field}</p>
                    </div>
                  </div>
                  <div class="timeline-meta">
                    <span>{entry.start} – {entry.end}</span>
                    <span class="inline-flex items-center gap-1">
                      <MapPin size={11} aria-hidden="true" />
                      {entry.location}
                    </span>
                  </div>
                </div>
                {entry.summary && (
                  <p class="mt-4 text-sm leading-relaxed text-muted">{entry.summary}</p>
                )}
              </article>
            ))
          }

          {
            certifications.map((certification) => (
              <article class="card p-5 sm:p-6">
                <div class="flex flex-wrap items-start justify-between gap-4">
                  <div class="flex gap-3.5">
                    <span class="skill-icon" aria-hidden="true">
                      <Award size={18} stroke-width={1.6} />
                    </span>
                    <div>
                      <h3 class="text-base font-semibold">{certification.title}</h3>
                      <p class="mt-0.5 text-sm text-accent">
                        {certification.issuer} · {certification.year}
                      </p>
                    </div>
                  </div>
                  <div class="timeline-meta">
                    <span class="inline-flex items-center gap-1">
                      <MapPin size={11} aria-hidden="true" />
                      {certification.location}
                    </span>
                  </div>
                </div>
                <p class="mt-4 text-sm leading-relaxed text-muted">{certification.summary}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section border-t border-line" aria-labelledby="experience-cta-title">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-xl">
          <p class="mono-label">Next step</p>
          <h2 class="section-title mt-4" id="experience-cta-title">
            Looking for a backend engineer who ships?
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            I am open to remote backend, platform, and AI engineering roles.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href={withBase('/skills/')} class="btn btn-secondary">See skills</a>
          <a href={withBase('/#contact')} class="btn btn-primary">Contact me</a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
