---
import { ArrowLeft, ArrowUpRight, CircleCheck, Sparkles } from '@lucide/astro';
import MainLayout from '@/layouts/MainLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import SocialIcon from '@/components/SocialIcon.astro';
import { projects, type Project } from '@/data/projects';
import { formatDate } from '@/utils/date';
import { withBase } from '@/utils/url';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const related = projects
  .filter((candidate) => candidate.slug !== project.slug)
  .sort((a, b) => Number(b.featured) - Number(a.featured))
  .slice(0, 2);
---

<MainLayout
  title={`${project.title} — Project`}
  description={project.tagline}
  image={project.cover}
  imageAlt={project.coverAlt}
>
  <article>
    <header class="border-b border-line">
      <div class="container-page pb-10 pt-12 sm:pb-14 sm:pt-16">
        <a
          href={withBase('/projects/')}
          class="inline-flex items-center gap-1.5 text-xs text-muted hover:text-fg"
        >
          <ArrowLeft size={13} aria-hidden="true" />
          All projects
        </a>

        <div class="mt-7 grid grid-cols-[minmax(0,1fr)] gap-8 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-end">
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <span class="badge badge-accent">{project.category}</span>
              <span class="badge">{project.status}</span>
              {project.sample && <span class="badge">Sample</span>}
            </div>

            <h1 class="page-title mt-5">{project.title}</h1>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
              {project.tagline}
            </p>

            {
              (project.demo || project.github) && (
                <div class="mt-6 flex flex-wrap items-center gap-2">
                  {project.demo && (
                    <a
                      href={project.demo}
                      class="btn btn-primary"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Visit project
                      <ArrowUpRight size={15} aria-hidden="true" />
                    </a>
                  )}
                  {project.github && (
                    <a
                      href={project.github}
                      class="btn btn-secondary"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <SocialIcon platform="github" size={14} />
                      Source
                    </a>
                  )}
                </div>
              )
            }
          </div>

          <ul class="flex flex-wrap gap-1.5 lg:justify-end" aria-label="Technologies">
            {project.technologies.map((technology) => <li class="tag">{technology}</li>)}
          </ul>
        </div>
      </div>
    </header>

    <div class="container-page py-10 sm:py-14">
      <figure class="overflow-hidden rounded-2xl border border-line">
        <img
          src={withBase(project.cover)}
          alt={project.coverAlt}
          width="1200"
          height="750"
          class="w-full"
          loading="eager"
          decoding="async"
        />
      </figure>

      <div class="mt-12 grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-16">
        <div class="min-w-0">
          {
            project.sample && (
              <div class="callout mb-8">
                <Sparkles size={17} class="mt-0.5 shrink-0 text-accent" stroke-width={1.7} aria-hidden="true" />
                <div>
                  <p class="callout-title">Sample project</p>
                  <p class="callout-body">
                    This is starter content included with the portfolio template, not a real
                    personal project. Replace its copy, links, and cover in
                    <code class="font-mono text-[0.72rem]">src/data/projects.ts</code>.
                  </p>
                </div>
              </div>
            )
          }

          <p class="mono-label">Overview</p>
          <div class="mt-5 grid gap-4 text-[0.98rem] leading-[1.8] text-muted">
            {project.description.map((paragraph) => <p>{paragraph}</p>)}
          </div>

          {
            project.highlights.length > 0 && (
              <section class="mt-10" aria-labelledby="highlights-title">
                <h2 class="section-title" id="highlights-title">What I worked on</h2>
                <ul class="mt-5 grid gap-3">
                  {project.highlights.map((highlight) => (
                    <li class="flex gap-2.5 text-sm leading-relaxed text-muted">
                      <CircleCheck
                        size={16}
                        class="mt-0.5 shrink-0 text-accent"
                        stroke-width={1.8}
                        aria-hidden="true"
                      />
                      {highlight}
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6">
            <a
              href={withBase('/projects/')}
              class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-fg"
            >
              <ArrowLeft size={14} aria-hidden="true" />
              Back to projects
            </a>
            <a href={withBase('/#contact')} class="link-arrow">
              Discuss this project
              <ArrowUpRight size={14} aria-hidden="true" />
            </a>
          </div>
        </div>

        <aside aria-label="Project details">
          <div class="card sticky top-24 p-5">
            <p class="mono-label">Details</p>
            <dl class="mt-4 grid gap-3 text-sm">
              <div class="flex items-start justify-between gap-4">
                <dt class="text-faint">Role</dt>
                <dd class="text-right text-muted">{project.role ?? 'Project'}</dd>
              </div>
              <div class="flex items-start justify-between gap-4">
                <dt class="text-faint">Category</dt>
                <dd class="text-right text-muted">{project.category}</dd>
              </div>
              <div class="flex items-start justify-between gap-4">
                <dt class="text-faint">Status</dt>
                <dd class="text-right text-muted">{project.status}</dd>
              </div>
              {
                project.date && (
                  <div class="flex items-start justify-between gap-4">
                    <dt class="text-faint">Published</dt>
                    <dd class="text-right text-muted">
                      <time datetime={project.date}>{formatDate(new Date(project.date))}</time>
                    </dd>
                  </div>
                )
              }
            </dl>

            <div class="mt-5 border-t border-line pt-4">
              <p class="font-mono text-[0.62rem] uppercase tracking-wider text-faint">Stack</p>
              <ul class="mt-2.5 flex flex-wrap gap-1.5">
                {project.technologies.map((technology) => <li class="tag">{technology}</li>)}
              </ul>
            </div>

            {
              project.demo && (
                <a
                  href={project.demo}
                  class="btn btn-secondary mt-5 w-full"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Live demo
                  <ArrowUpRight size={14} aria-hidden="true" />
                </a>
              )
            }
            {
              project.github && (
                <a
                  href={project.github}
                  class="btn btn-secondary mt-2 w-full"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <SocialIcon platform="github" size={14} />
                  Repository
                </a>
              )
            }
          </div>
        </aside>
      </div>

      {
        related.length > 0 && (
          <section class="mt-16 border-t border-line pt-12" aria-labelledby="more-projects-title">
            <div class="flex items-end justify-between gap-4">
              <div>
                <p class="mono-label">More work</p>
                <h2 class="section-title mt-3" id="more-projects-title">Other projects</h2>
              </div>
              <a href={withBase('/projects/')} class="link-arrow hidden sm:inline-flex">
                All projects
              </a>
            </div>
            <div class="project-grid mt-6">
              {related.map((candidate) => <ProjectCard project={candidate} />)}
            </div>
          </section>
        )
      }
    </div>
  </article>
</MainLayout>
