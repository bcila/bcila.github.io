---
import MainLayout from '@/layouts/MainLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects, projectCategories } from '@/data/projects';
import { profile } from '@/data/profile';
import { withBase } from '@/utils/url';

const categories = projectCategories.filter((category) =>
  projects.some((project) => project.category === category),
);

const sampleCount = projects.filter((project) => project.sample).length;
---

<MainLayout
  title="Projects"
  description={`Selected backend, realtime, and AI projects by ${profile.name}.`}
>
  <header class="border-b border-line">
    <div class="container-page pb-12 pt-14 sm:pb-16 sm:pt-20">
      <div class="max-w-3xl">
        <p class="mono-label">Work</p>
        <h1 class="page-title mt-5">Projects</h1>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
          Production systems, experiments, and starter examples. Each project page covers the
          problem, the stack, and the parts worth talking about.
        </p>
      </div>

      <div class="mt-9 flex flex-wrap items-center justify-between gap-4">
        <div class="filter-bar" role="group" aria-label="Filter projects by category">
          <button class="filter-button" type="button" data-project-filter="all" aria-pressed="true">
            All
            <span class="filter-count">{projects.length}</span>
          </button>
          {
            categories.map((category) => (
              <button
                class="filter-button"
                type="button"
                data-project-filter={category}
                aria-pressed="false"
              >
                {category}
                <span class="filter-count">
                  {projects.filter((project) => project.category === category).length}
                </span>
              </button>
            ))
          }
        </div>

        <p class="font-mono text-[0.66rem] text-faint" aria-live="polite" data-project-status>
          {projects.length} projects
        </p>
      </div>
    </div>
  </header>

  <section class="section-sm" aria-label="Project list">
    <div class="container-page">
      <div class="project-grid" data-project-grid>
        {
          projects.map((project, index) => (
            <ProjectCard
              project={project}
              variant={index === 0 && project.featured ? 'featured' : 'default'}
              headingLevel="h2"
            />
          ))
        }
      </div>

      <div class="empty-state mt-6" data-project-empty>
        No projects in this category yet.
      </div>

      {
        sampleCount > 0 && (
          <p class="mt-6 text-xs leading-relaxed text-faint">
            {sampleCount} entries are labelled <span class="text-muted">Sample</span> — starter
            content included with the template, not claims about shipped work. Replace them in
            <code class="rounded border border-line bg-panel px-1 py-0.5 font-mono text-[0.68rem]">
              src/data/projects.ts
            </code>.
          </p>
        )
      }
    </div>
  </section>

  <section class="section border-t border-line" aria-label="Project enquiries">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-xl">
          <p class="mono-label">Next</p>
          <h2 class="section-title mt-4">Want the longer version of any of these?</h2>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Happy to walk through architecture decisions, trade-offs, or what I would change.
          </p>
        </div>
        <a href={withBase('/#contact')} class="btn btn-primary">Get in touch</a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  @media (min-width: 701px) {
    .project-grid :global(.featured-project) {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-project-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-project-card]');
  const status = document.querySelector<HTMLElement>('[data-project-status]');
  const empty = document.querySelector<HTMLElement>('[data-project-empty]');

  const applyFilter = (filter: string) => {
    let visible = 0;

    cards.forEach((card) => {
      const show = filter === 'all' || card.dataset.category === filter;
      card.hidden = !show;
      if (show) visible += 1;
    });

    filterButtons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.projectFilter === filter));
    });

    if (status) status.textContent = `${visible} ${visible === 1 ? 'project' : 'projects'}`;
    if (empty) empty.dataset.visible = String(visible === 0);
  };

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => applyFilter(button.dataset.projectFilter ?? 'all'));
  });
</script>
